# ---------------------------------------------------------------------
# Backend environment configuration.
#
# IMPORTANT — this project uses TWO separate data stores, and confusing
# them is the single easiest way to break auth:
#
#   * DATABASE_URL  -> OUR application Postgres. Holds users,
#     organizations, organization_memberships, projects, repositories,
#     chunks, and everything else in services/backend/migrations/.
#     Locally this is the docker-compose `postgres` service.
#
#   * SUPABASE_*    -> Supabase, used for AUTHENTICATION ONLY. Holds
#     auth.users. It does NOT hold any of our tables.
#
# The two are bridged one-directionally by the Supabase webhook: on
# user.created, Supabase calls POST /webhooks/supabase and our backend
# provisions a mirror user + starter organization in the application
# Postgres.
#
# Consequence worth internalizing: a Supabase Auth Hook (which executes
# inside Supabase's own database) CANNOT query our tables. Org context
# reaches the JWT by writing raw_app_meta_data on the Supabase user via
# the Admin API, which Supabase then surfaces as the `app_metadata`
# claim. See .planning/phases/19-auth-wiring-org-provisioning/.
#
# Do NOT point DATABASE_URL at Supabase. Besides mixing our schema into
# theirs, Supabase's direct database host is IPv6-only; reaching it over
# IPv4 requires their connection pooler, which is a different hostname.
# ---------------------------------------------------------------------

# Application database (docker-compose `postgres` service, host port 5434).
# Inside the compose network use:
#   postgres://coderag:coderag@postgres:5432/coderag?sslmode=disable
DATABASE_URL=postgres://coderag:coderag@localhost:5434/coderag?sslmode=disable

# Vector Database Configuration
QDRANT_URL=http://qdrant:6333

# Cache Configuration. Required for OAuth — the state store (CSRF
# protection) is Redis-backed. If Redis is unreachable the OAuth routes
# are skipped at router construction with a logged warning; the rest of
# the API still starts.
REDIS_URL=redis://localhost:6379

# Supabase (authentication only - see header note).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# REQUIRED, and must be non-empty. Since Phase 19-01 the webhook handler
# has no signature-bypass fallback: NewRouterWithValidator panics at
# construction rather than silently accepting unsigned webhook payloads.
# Any non-empty value works locally. In a deployed environment it must
# match the secret configured on the Supabase webhook itself.
SUPABASE_WEBHOOK_SECRET=your-webhook-secret

# OAuth Configuration
BASE_URL=http://localhost:8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Application Configuration
ENV=development
PORT=8080
