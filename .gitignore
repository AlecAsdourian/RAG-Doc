# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
nul

# Environment
.env
.env.local
.env.*.local
# Backups of .env files (e.g. services/backend/.env.bak-20260908) carry the
# same secrets as the file they copy.
.env.bak*

# Private keys. The GitHub App's private key must live OUTSIDE the repository;
# this rule is the backstop for when one is copied in by mistake.
*.pem

# Logs
*.log
logs/

# Dependencies
node_modules/

# Temp / junk
tmpclaude-*
ngrok.exe
=*

# Claude Code local settings (may contain API keys)
.claude/settings.local.json

# Stitch MCP generated reference HTML files in phase dirs (not the main ref)
.planning/phases/*/front-end_reference/
